<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

<t t-name="kio_pos_product_exchange.ClosePosPopupCashDenominations"
   t-inherit="point_of_sale.ClosePosPopup"
   t-inherit-mode="extension">
    <xpath expr="//div[hasclass('payment-methods-overview')]" position="after">
        <section t-if="pos.config.show_cash_denominations"
                 class="cash-denomination-details border-top mt-2 pt-2">
                <h5 class="cash-denomination-title text-start mb-1">Cash Denomination Details</h5>
                <div class="cash-denomination-table-container">
                    <table class="cash-denomination-table text-start">
                        <thead>
                            <tr class="text-dark">
                                <th>Denomination</th>
                                <th>Note</th>
                                <th>Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.cashDenominations"
                                t-as="denomination"
                                t-key="denomination.value">
                                <td t-esc="denomination.value"/>
                                <td>
                                    <input type="number"
                                           min="0"
                                           step="1"
                                           inputmode="numeric"
                                           class="form-control cash-denomination-quantity"
                                           t-att-value="denomination.quantity"
                                           t-on-input="(event) => this.setDenominationQuantity(denomination, event)"/>
                                </td>
                                <td t-esc="getDenominationAmount(denomination)"/>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td>Total</td>
                                <td>
                                    <div class="cash-denomination-total d-flex align-items-center justify-content-end gap-2">
                                        <span class="cash-denomination-total-label">Total Notes</span>
                                        <span class="cash-denomination-total-value" t-esc="getTotalNoteQuantity()"/>
                                    </div>
                                </td>
                                <td>
                                    <div class="cash-denomination-total d-flex align-items-center justify-content-end gap-2">
                                        <span class="cash-denomination-total-label">Total Amount</span>
                                        <span class="cash-denomination-total-value" t-esc="getDenominationTotalAmount()"/>
                                    </div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </section>
        </xpath>
    </t>

</templates>
