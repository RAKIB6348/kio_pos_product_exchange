<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="kio_pos_product_exchange.TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('leftpane')]" position="attributes">
            <attribute name="t-att-class">{ 'd-none': exchangeMode }</attribute>
        </xpath>
    </t>

    <t t-name="kio_pos_product_exchange.ExchangeDetailsPopup">
        <div class="popup exchange-details-popup">
            <div class="modal-header">
                <h4 class="modal-title title">
                    <t t-esc="props.title" />
                </h4>
                <button class="btn btn-light btn-lg rounded-3 popup-close" t-on-click="cancel">
                    <i class="fa fa-close" />
                </button>
            </div>
            <main class="modal-body exchange-details-body">
                <div class="exchange-meta-row">
                    <span class="exchange-meta-label">Receipt</span>
                    <span class="exchange-meta-value" t-esc="props.order.name" />
                </div>
                <div class="exchange-meta-row">
                    <span class="exchange-meta-label">Customer</span>
                    <span class="exchange-meta-value" t-esc="props.partner" />
                </div>
                <div class="exchange-meta-row">
                    <span class="exchange-meta-label">Cashier</span>
                    <span class="exchange-meta-value" t-esc="props.cashier" />
                </div>
                <div class="exchange-meta-row">
                    <span class="exchange-meta-label">Date</span>
                    <span class="exchange-meta-value" t-esc="props.date" />
                </div>
                <div class="exchange-meta-row">
                    <span class="exchange-meta-label">Total</span>
                    <span class="exchange-meta-value" t-esc="props.total" />
                </div>

                <div class="exchange-type-section">
                    <div class="exchange-type-title fw-bolder">Exchange Type</div>
                    <div class="exchange-type-options">
                        <label class="exchange-type-option">
                            <input type="radio"
                                   t-att-name="'exchange_type_' + props.id"
                                   value="same_product"
                                   t-att-checked="state.exchangeChoice === 'same_product'"
                                   t-on-change="() => this.selectExchangeChoice('same_product')"/>
                            <span>Same Product</span>
                        </label>
                        <label class="exchange-type-option">
                            <input type="radio"
                                   t-att-name="'exchange_type_' + props.id"
                                   value="new_product"
                                   t-att-checked="state.exchangeChoice === 'new_product'"
                                   t-on-change="() => this.selectExchangeChoice('new_product')"/>
                            <span>New Product</span>
                        </label>
                    </div>
                </div>

                <div class="exchange-products-title fw-bolder">Products</div>
                <div class="exchange-product-list">
                    <div class="exchange-product-header">
                        <span class="exchange-col-product">Product</span>
                        <span class="exchange-col-purchased-qty">Purchased Qty</span>
                        <span class="exchange-col-exchange-qty">Exchange Qty</span>
                    </div>
                    <t t-foreach="orderlines" t-as="line" t-key="line.id">
                        <div class="exchange-product-row"
                            t-att-class="{
                                'selected': isLineSelected(line),
                                'ineligible': !canSelectLine(line)
                            }"
                            t-on-click="() => this.onLineClick(line)">
                            <i t-attf-class="fa {{ isLineSelected(line) ? 'fa-check-square-o' : 'fa-square-o' }}"/>
                            <span class="exchange-col-product" t-esc="line.getDisplayData().productName" />
                            <span class="exchange-col-purchased-qty" t-esc="line.getDisplayData().qty"/>
                            <span class="exchange-col-exchange-qty" t-on-click.stop="() => {}">
                                <input type="number"
                                       min="0"
                                       step="any"
                                       t-att-max="line.get_quantity()"
                                       t-att-value="getExchangeQty(line)"
                                       t-att-disabled="!isLineSelected(line)"
                                       t-att-class="{ 'is-invalid': isLineSelected(line) &amp;&amp; !isExchangeQtyValid(line) }"
                                       class="form-control exchange-qty-input"
                                       t-on-input="(event) => this.onExchangeQtyInput(line, event)"/>
                            </span>
                        </div>
                    </t>
                </div>
                <div class="exchange-selection-summary">
                    <span>Selected: <b t-esc="selectedLines.length"/> Products</span>
                    <span>Total Exchange Amount: <b t-esc="getFormattedTotalExchangeValue()"/></span>
                </div>
            </main>
            <div class="footer modal-footer">
                <div t-if="state.exchangeChoice"
                    t-att-class="{ 'disabled': !canContinue() }"
                    class="button continue-exchange btn btn-lg btn-primary me-2"
                    t-on-click="confirm">
                    <t t-esc="state.exchangeChoice === 'same_product' ? props.validateText : props.continueText" />
                </div>
                <div class="button cancel btn btn-lg btn-danger" t-on-click="cancel">
                    <t t-esc="props.cancelText" />
                </div>
            </div>
        </div>
    </t>

    <t t-name="kio_pos_product_exchange.ActionpadWidget" t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('pay-order-button')]" position="before">
            <button t-if="pos.exchangeState &amp;&amp; pos.exchangeState.exchangeOrder === pos.get_order() &amp;&amp; pos.exchangeState.noRefundExchange"
                    class="pay validation pay-order-button exchange-validate-button button btn d-flex flex-column flex-fill align-items-center justify-content-center fw-bolder btn-lg rounded-0 btn-primary"
                    t-on-click="() => pos.get_order().pay()">
                <div class="pay-circle d-flex align-items-center justify-content-center py-2 mb-2">
                    <i class="fa fa-check" role="img" aria-label="Validate" title="Validate" />
                </div>
                <span class="text-white">Validate</span>
            </button>
        </xpath>
        <xpath expr="//button[hasclass('pay-order-button') and not(hasclass('exchange-validate-button'))]" position="attributes">
            <attribute name="t-if">!(pos.exchangeState &amp;&amp; pos.exchangeState.exchangeOrder === pos.get_order() &amp;&amp; pos.exchangeState.noRefundExchange)</attribute>
        </xpath>
    </t>

    <t t-name="kio_pos_product_exchange.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('pay-button')]" position="before">
            <button t-if="pos.exchangeState &amp;&amp; pos.exchangeState.exchangeOrder === currentOrder &amp;&amp; pos.exchangeState.noRefundExchange"
                    class="btn-switchpane pay-button exchange-validate-button btn w-50 rounded-0 fw-bolder btn-primary"
                    t-on-click="() => currentOrder.pay()">
                <span class="fs-1 d-block">Validate</span>
                <span><t t-esc="total" /></span>
            </button>
        </xpath>
        <xpath expr="//button[hasclass('pay-button') and not(hasclass('exchange-validate-button'))]" position="attributes">
            <attribute name="t-if">!(pos.exchangeState &amp;&amp; pos.exchangeState.exchangeOrder === currentOrder &amp;&amp; pos.exchangeState.noRefundExchange)</attribute>
        </xpath>
    </t>

</templates>
