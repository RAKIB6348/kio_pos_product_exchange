<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_exchange_record_tree" model="ir.ui.view">
        <field name="name">pos.exchange.record.tree</field>
        <field name="model">pos.exchange.record</field>
        <field name="arch" type="xml">
            <tree string="Exchange Records" create="0" edit="0" delete="0">
                <field name="name" decoration-bf="1"/>
                <field name="source_order_id"/>
                <field name="exchange_order_id"/>
                <field name="customer_id"/>
                <field name="old_total" widget="monetary"/>
                <field name="replacement_total" widget="monetary"/>
                <field name="adjustment_total" widget="monetary"/>
                <field name="customer_payable" widget="monetary"/>
                <field name="difference_amount" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="cashier_id"/>
                <field name="exchange_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"
                       decoration-warning="state == 'refunded'"
                       decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_pos_exchange_record_form" model="ir.ui.view">
        <field name="name">pos.exchange.record.form</field>
        <field name="model">pos.exchange.record</field>
        <field name="arch" type="xml">
            <form string="Exchange Record" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group string="General Information">
                            <field name="name"/>
                            <field name="source_order_id"/>
                            <field name="exchange_order_id"/>
                            <field name="customer_id"/>
                            <field name="config_id"/>
                            <field name="session_id"/>
                            <field name="cashier_id"/>
                            <field name="exchange_date"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'completed'"
                                   decoration-warning="state == 'refunded'"
                                   decoration-danger="state == 'cancelled'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Product Details">
                            <separator string="Old Product"/>
                            <field name="line_ids" class="exchange-detail-lines" nolabel="1" readonly="1">
                                <tree create="0" edit="0" delete="0">
                                    <field name="old_product_id" string="Product"/>
                                    <field name="old_product_barcode" string="Barcode"/>
                                    <field name="old_qty" string="Quantity"/>
                                    <field name="old_unit_price" string="Unit Price" widget="monetary"/>
                                    <field name="old_total" string="Total" widget="monetary"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </tree>
                            </field>
                            <separator string="Exchange Product"/>
                            <field name="replacement_line_ids" class="exchange-detail-lines" nolabel="1" readonly="1">
                                <tree create="0" edit="0" delete="0">
                                    <field name="replacement_product_id" string="Product"/>
                                    <field name="replacement_product_barcode" string="Barcode"/>
                                    <field name="replacement_qty" string="Quantity"/>
                                    <field name="replacement_unit_price" string="Unit Price" widget="monetary"/>
                                    <field name="replacement_total" string="Total" widget="monetary"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <group col="12">
                        <group colspan="8"/>
                        <group class="oe_subtotal_footer" colspan="4" name="exchange_total">
                            <field name="currency_id" invisible="1"/>
                            <field name="old_total" string="Old Product Total" widget="monetary"/>
                            <field name="replacement_total" string="Exchange Product Total" widget="monetary"/>
                            <field name="adjustment_total" string="Forfeited Adjustment" widget="monetary"/>
                            <field name="customer_payable" string="Customer Payable" widget="monetary"/>
                            <label for="difference_amount" string="Difference" class="oe_subtotal_footer_separator"/>
                            <field name="difference_amount" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pos_exchange_record_search" model="ir.ui.view">
        <field name="name">pos.exchange.record.search</field>
        <field name="model">pos.exchange.record</field>
        <field name="arch" type="xml">
            <search string="Exchange Records">

                <field name="name"/>
                <field name="source_order_id"/>
                <field name="exchange_order_id"/>
                <field name="customer_id"/>
                <field name="config_id"/>
                <field name="cashier_id"/>
                <field name="state"/>

                <separator/>

                <filter name="exchange_date"
                        string="Exchange Date"
                        date="exchange_date"/>

                <separator/>

                <filter name="completed"
                        string="Completed"
                        domain="[('state', '=', 'completed')]"/>

                <filter name="refunded"
                        string="Refunded"
                        domain="[('state', '=', 'refunded')]"/>

                <filter name="cancelled"
                        string="Cancelled"
                        domain="[('state', '=', 'cancelled')]"/>

                <separator/>

                <group expand="0" string="Group By">
                    <filter name="group_by_shop"
                            string="Shop"
                            context="{'group_by': 'config_id'}"/>

                    <filter name="group_by_customer"
                            string="Customer"
                            context="{'group_by': 'customer_id'}"/>

                    <filter name="group_by_cashier"
                            string="Cashier"
                            context="{'group_by': 'cashier_id'}"/>

                    <filter name="group_by_state"
                            string="Status"
                            context="{'group_by': 'state'}"/>
                </group>

            </search>
        </field>
    </record>

    <record id="action_pos_exchange_record" model="ir.actions.act_window">
        <field name="name">Exchange Records</field>
        <field name="res_model">pos.exchange.record</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_pos_exchange_record_tree"/>
        <field name="search_view_id" ref="view_pos_exchange_record_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No exchange records found.</p>
        </field>
    </record>

    <menuitem
        id="menu_exchange_records"
        name="Exchange Records"
        parent="point_of_sale.menu_point_root"
        action="action_pos_exchange_record"
        groups="kio_branch_inventory.group_branch_inventory_user"
        sequence="20"/>
</odoo>
